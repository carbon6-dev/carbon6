{
  "package": "gmail",
  "version": "1.2.1",
  "description": "Your Gmail in carbon6: every message kept and searchable, synced both ways (labels, read, archive, trash), drafts and sending. Mail is untrusted input: agents get it as quoted data.",
  "requires": {
    "google": "^1.2"
  },
  "feeds": [
    "mail"
  ],
  "links": {
    "service": "Gmail",
    "thread": "https://mail.google.com/mail/?authuser={account}#all/{thread}"
  },
  "permissions": {
    "secrets": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "providers": [
    {
      "name": "google",
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "scopes": [
        "openid",
        "email",
        "profile",
        "https://www.googleapis.com/auth/gmail.modify",
        "https://www.googleapis.com/auth/gmail.send"
      ],
      "userinfo_url": "https://www.googleapis.com/oauth2/v3/userinfo",
      "account_field": "email",
      "params": {
        "access_type": "offline",
        "prompt": "consent"
      },
      "client_id_secret": "GOOGLE_CLIENT_ID",
      "client_secret_secret": "GOOGLE_CLIENT_SECRET"
    }
  ],
  "contents": {
    "collections": [
      {
        "name": "gmail_sync",
        "description": "Where each account's mail sync is: its history cursor, waiting messages, import and label check, and quota back-off.",
        "schema": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "what syncs: mail:<account>, cal:<account>:<calendar>, contacts:<account>"
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "page_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "queue": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "phase": {
              "type": "string",
              "enum": [
                "import",
                "live"
              ]
            },
            "done": {
              "type": "integer"
            },
            "checked": {
              "type": "integer",
              "description": "the check of kept labels it has had"
            },
            "check_page": {
              "type": [
                "string",
                "null"
              ]
            },
            "check_queue": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fetch_queue": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "tell": {
                    "type": "boolean"
                  }
                }
              },
              "description": "new messages waiting for their bytes, with whether to tell about them"
            },
            "first": {
              "type": [
                "string",
                "null"
              ],
              "description": "the queue whose head gets first turn after it did not fit"
            },
            "history_more": {
              "type": "boolean",
              "description": "history left for the next run"
            },
            "history_record": {
              "type": [
                "string",
                "null"
              ],
              "description": "a history record partly handled, before the cursor can advance"
            },
            "history_offset": {
              "type": "integer",
              "description": "changes already handled within that history record"
            },
            "import_turn": {
              "type": "integer",
              "description": "when this import last took a turn, so accounts take turns"
            },
            "retry_at": {
              "type": [
                "integer",
                "null"
              ],
              "description": "when Google calls may resume after a quota error (ms since the epoch)"
            },
            "retry_count": {
              "type": "integer",
              "description": "consecutive quota failures, for doubling the wait"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "type": "integer"
            }
          }
        },
        "keys": [
          "key"
        ],
        "card": {
          "stability": "internal",
          "sources": "The google kit's syncs.",
          "freshness": "Every run."
        }
      }
    ],
    "triggers": [
      {
        "name": "gmail sync",
        "trigger": "schedule",
        "cron": "*/2 * * * *",
        "action": "kit",
        "action_params": {
          "kit": "google",
          "tool": "mail-sync",
          "state": [
            "gmail_sync"
          ]
        },
        "per_hour": 60
      }
    ]
  },
  "operations": [
    {
      "name": "modify",
      "description": "Adds and removes labels on a thread: read (UNREAD), archive (INBOX), star (STARRED), trash (TRASH), or yours.",
      "input": {
        "type": "object",
        "required": [
          "account",
          "thread"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "thread": {
            "type": "string"
          },
          "add": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "kit": {
        "kit": "google",
        "tool": "mail-modify"
      }
    },
    {
      "name": "send",
      "description": "Sends a message (RFC 822, base64url), in a thread if it continues one.",
      "input": {
        "type": "object",
        "required": [
          "account",
          "raw"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          },
          "thread": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "kit": {
        "kit": "google",
        "tool": "mail-send"
      }
    },
    {
      "name": "draft",
      "description": "Saves a draft (new, or replacing draft_id).",
      "input": {
        "type": "object",
        "required": [
          "account",
          "raw"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          },
          "thread": {
            "type": [
              "string",
              "null"
            ]
          },
          "draft_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "kit": {
        "kit": "google",
        "tool": "mail-draft"
      }
    }
  ]
}