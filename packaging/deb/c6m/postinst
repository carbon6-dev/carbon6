#!/bin/sh
set -e

if [ "$1" = configure ]; then
    if ! getent passwd c6m >/dev/null; then
        adduser --quiet --system --group --home /var/lib/c6m --no-create-home c6m
    fi
    install -d -o c6m -g c6m -m 0700 /var/lib/c6m

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        [ -z "$2" ] || systemctl try-restart c6m.service
    fi

    if [ -z "$2" ]; then
        cat <<'MSG'
c6m: enroll the memex with a token from Settings → Memex (or `c6h enroll-token`), then start it:
       sudo -u c6m c6m --state-dir /var/lib/c6m enroll <token>
       sudo systemctl enable --now c6m
MSG
    fi
fi
