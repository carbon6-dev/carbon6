# The memex, as the c6m system user. Enroll it first (a token from
# Settings → Memex or `c6h enroll-token`), then start it:
#   sudo -u c6m c6m --state-dir /var/lib/c6m enroll <token>
#   sudo systemctl enable --now c6m
[Unit]
Description=carbon6 memex
Documentation=https://github.com/carbon6-dev/carbon6
Wants=network-online.target
After=network-online.target tailscaled.service
# Not enrolled yet: skip rather than fail.
ConditionPathExists=/var/lib/c6m/identity/worker.toml

[Service]
User=c6m
Group=c6m
ExecStart=/usr/bin/c6m --state-dir /var/lib/c6m run
StateDirectory=c6m
StateDirectoryMode=0700
Environment=NO_COLOR=1
# c6m stops cleanly on SIGTERM; anything it started is killed after it exits.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
