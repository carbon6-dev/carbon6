#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Where workers (any user's) leave updates for c6w-update.service, which
    # installs only what the release key signed (docs/updates.md).
    install -d -m 1777 /var/lib/c6w /var/lib/c6w/update
    chmod 0755 /var/lib/c6w

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable --now c6w-update.path
        [ -z "$2" ] || systemctl try-restart 'c6w@*.service'
    fi

    if [ -z "$2" ]; then
        cat <<'MSG'
c6w: enroll as the user the worker should run as, with a token from the Workers page:
       c6w enroll <token>
     then run it from boot:            sudo systemctl enable --now c6w@$USER
     or in your user session:          systemctl --user enable --now c6w
MSG
    else
        echo "c6w: restarted c6w@<user> services; restart user-session workers with: systemctl --user restart c6w"
    fi
fi
