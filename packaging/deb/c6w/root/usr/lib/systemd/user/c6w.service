# A worker in your own systemd user session:
#   c6w enroll <token>
#   systemctl --user enable --now c6w
#   sudo loginctl enable-linger $USER      (to keep it running while logged out)
[Unit]
Description=carbon6 worker
Documentation=https://github.com/carbon6-dev/carbon6

[Service]
# A login shell, so sessions get your PATH (~/.local/bin, ~/.cargo/bin, ...).
ExecStart=/bin/bash -lc 'exec /usr/bin/c6w run'
Environment=NO_COLOR=1
# c6w stops cleanly on SIGTERM and stops its sessions' processes itself.
# Only c6w is stopped here: background commands it holds outlive a restart
# (an update), and the next c6w takes them up (docs/restarts.md §3).
KillMode=process
# Keep other sessions running when one workload is OOM-killed. A user
# manager without permission to lower the score leaves it unchanged.
# c6w resets inherited negative adjustments before executing workloads.
# No default MemoryHigh: the daemon and held work share this cgroup;
# operators can set a host-specific percentage in a drop-in (docs/restarts.md).
OOMPolicy=continue
OOMScoreAdjust=-500
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
