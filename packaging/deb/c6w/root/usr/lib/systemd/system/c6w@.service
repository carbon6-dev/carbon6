# A worker that runs as the user named after the @, from boot:
#   c6w enroll <token>                      (as that user)
#   sudo systemctl enable --now c6w@$USER
[Unit]
Description=carbon6 worker for %i
Documentation=https://github.com/carbon6-dev/carbon6
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
User=%i
# A login shell, so sessions get the user's PATH (~/.local/bin, ~/.cargo/bin, ...).
ExecStart=/bin/bash -lc 'exec /usr/bin/c6w run'
Environment=NO_COLOR=1
# c6w stops cleanly on SIGTERM and stops its sessions' processes itself.
# Only c6w is stopped here: background commands it holds outlive a restart
# (an update), and the next c6w takes them up (docs/restarts.md §3).
KillMode=process
# An OOM-killed workload shouldn't stop the worker or other sessions.
# Children inherit the adjustment; c6w resets workloads to zero before exec.
# Held work leaves the process group, not this cgroup: keep KillMode=process.
# No default MemoryHigh: reclaim would throttle the daemon and all sessions;
# operators can budget their host with a percentage in a drop-in (docs/restarts.md).
OOMPolicy=continue
OOMScoreAdjust=-500
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
