[Unit]
Description=carbon6 head
Documentation=https://github.com/carbon6-dev/carbon6
# The head binds the private and tailnet addresses it finds at start, so
# start after the network (and Tailscale, when installed) is up.
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
User=c6h
Group=c6h
ExecStart=/usr/bin/c6h --config /etc/c6h/c6h.toml serve
StateDirectory=c6h
StateDirectoryMode=0700
Environment=NO_COLOR=1
# c6h stops cleanly on SIGTERM; anything it started is killed after it exits.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
